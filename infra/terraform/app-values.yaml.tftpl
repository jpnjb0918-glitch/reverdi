image:
  repository: "${backend_repository}"
  tag: "${image_tag}"
  pullPolicy: IfNotPresent

crawlerImage:
  repository: "${crawler_repository}"

replicaCount: 3

nodeSelector:
  workload: web

resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    cpu: "1"
    memory: 1Gi

strategy:
  maxSurge: 1
  maxUnavailable: 0

topologySpread:
  enabled: true
  maxSkew: 1
  topologyKey: topology.kubernetes.io/zone
  whenUnsatisfiable: DoNotSchedule

pdb:
  enabled: true
  minAvailable: 2

hpa:
  enabled: true
  minReplicas: 3
  maxReplicas: 6
  targetCPUUtilizationPercentage: 70

config:
  LOG_LEVEL: "INFO"
  LOG_FORMAT: "json"
  ENABLE_CRAWLER: "false"
  ALLOWED_ORIGINS: ""
  APP_ENV: "production"
  COOKIE_SECURE: "${cookie_secure}"
  ALLOW_LOCAL_STORAGE: "false"
  S3_BUCKET: "${bucket}"
  AWS_REGION: "${region}"
  S3_PUBLIC_BASE: ""
  TRUST_PROXY_HEADERS: "true"
  DATABASE_SSL_MODE: "require"

  # 🔴 시연용 판매자 계정 연결 (2026-09-20)
  #    client 계정이 이 id 의 판매자로 동작한다.
  #    0 이면 CSV 업로드가 거부된다.
  #    ⚠️ sellers 에 시드가 없어 손으로 넣었다. 재구축 시 확인:
  #         select id, name from sellers;
  CLIENT_SELLER_ID: "2"

secret:
  create: false
  name: reverdi-secret

secretScope:
  perWorkload: true
  dbSecretName: reverdi-db-secret

crawler:
  enabled: true
  schedule: "*/30 * * * *"

aggregate:
  enabled: false

pgdump:
  enabled: false

migrate:
  enabled: true

serviceAccountName: reverdi-web
batchServiceAccountName: reverdi-batch

ingress:
  enabled: true
  className: alb
  host: "${domain}"
  certificateArn: "${certificate_arn}"
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    # 🔴 xff 모드를 명시한다 (2026-09-19)
    #    ALB 컨트롤러 v3.5.0 이 이 속성을 빈 값으로 보내 AWS 가 거부한다.
    #      ValidationError: 'routing.http.xff_header_processing.mode'
    #      must be set as 'preserve', 'append', or 'remove'
    #    ALB 는 만들어지지만 속성 적용에서 멈춰 Ingress 에 주소가 안 붙는다.
    alb.ingress.kubernetes.io/load-balancer-attributes: routing.http.xff_header_processing.mode=append
    alb.ingress.kubernetes.io/target-type: ip
    # 🔴 ALB 를 하나만 만든다.
    #    같은 group.name 을 쓰는 Ingress 들이 ALB 를 나눠 쓴다.
    #    앱과 Grafana 가 각자 만들면 월 $16 이 더 든다.
    alb.ingress.kubernetes.io/group.name: reverdi
    alb.ingress.kubernetes.io/group.order: "10"
    alb.ingress.kubernetes.io/healthcheck-path: /health
    alb.ingress.kubernetes.io/listen-ports: '${https_enabled ? "[{\"HTTP\":80},{\"HTTPS\":443}]" : "[{\"HTTP\":80}]"}'
%{ if https_enabled }    alb.ingress.kubernetes.io/ssl-redirect: "443"%{ endif }
    alb.ingress.kubernetes.io/target-group-attributes: deregistration_delay.timeout_seconds=30
    alb.ingress.kubernetes.io/load-balancer-attributes: routing.http.xff_header_processing.mode=append

# ---------------------------------------------------------------------------
# 🔴 Prometheus 수집 설정
#
#    앱은 prometheus-fastapi-instrumentator 로 /metrics 를 내보낸다.
#    ServiceMonitor 가 있어야 Prometheus 가 그걸 긁어간다.
#    없으면 요청 수·p95·에러율 대시보드가 빈 화면이 된다.
#
#    ⚠️ kube-prometheus-stack 의 CRD 가 있을 때만 만들어진다.
#       로컬 초기 구축처럼 CRD 가 없으면 조용히 건너뛴다.
# ---------------------------------------------------------------------------
metrics:
  serviceMonitor:
    enabled: true
    path: /metrics
    interval: 30s
    scrapeTimeout: 10s
    labels: {}
