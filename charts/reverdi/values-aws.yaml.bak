# ===========================================================================
# AWS (EKS) 전용 값
#
#   helm upgrade --install reverdi charts/reverdi -n reverdi -f charts/reverdi/values-aws.yaml
#
# 🔴 <> 로 표시한 곳은 실제 값으로 바꿔야 한다.
#    image.tag 는 Jenkins 가 커밋 해시로 갱신한다 (직접 고치지 말 것).
# ===========================================================================

# ---------------------------------------------------------------------------
# 이미지 — ECR
# ---------------------------------------------------------------------------
image:
  repository: <AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com/reverdi-backend
  # ↓ Jenkins 가 커밋 해시 7자리로 갱신한다
  tag: "latest"
  pullPolicy: IfNotPresent

crawlerImage:
  repository: <AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com/reverdi-crawler

# ---------------------------------------------------------------------------
# 외부 접근 — ALB
# Ingress 를 만들면 AWS Load Balancer Controller 가 실제 ALB 를 생성한다.
# 컨트롤러를 Helm 으로 설치하지 않으면 아무 일도 일어나지 않는다.
# ---------------------------------------------------------------------------
nodeport:
  enabled: false

ingress:
  enabled: true
  className: alb
  host: ""            # 도메인이 정해지면 채운다. 비우면 ALB DNS 로 접속
  certificateArn: "arn:aws:acm:ap-northeast-2:<AWS_ACCOUNT_ID>:certificate/<CERT_ID>"
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    # 파드 IP 로 직접 분산. VPC CNI 라 가능하다.
    alb.ingress.kubernetes.io/target-type: ip
    # 🔴 /ready 가 아니다. /ready 는 DB 를 확인하므로
    #    DB 장애 시 파드 3개가 동시에 대상그룹에서 빠진다.
    alb.ingress.kubernetes.io/healthcheck-path: /health
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
    alb.ingress.kubernetes.io/ssl-redirect: "443"
    # 종료 중인 파드로 요청이 가지 않도록 등록취소 지연
    alb.ingress.kubernetes.io/target-group-attributes: deregistration_delay.timeout_seconds=30

# ---------------------------------------------------------------------------
# 규모
# ---------------------------------------------------------------------------
replicaCount: 3

topologySpread:
  enabled: true
  maxSkew: 1
  topologyKey: topology.kubernetes.io/zone
  # 운영에서는 분산이 안 되면 Pending 으로 남긴다.
  # 노드가 부족한 상태를 조용히 넘기지 않기 위해서다.
  whenUnsatisfiable: DoNotSchedule

pdb:
  enabled: true
  minAvailable: 2

hpa:
  enabled: true
  minReplicas: 3
  maxReplicas: 6
  targetCPUUtilizationPercentage: 70

# ---------------------------------------------------------------------------
# 자원 — t3.medium(2vCPU 4GB) 노드에 파드 여러 개가 뜨는 것을 감안
# ---------------------------------------------------------------------------
resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    cpu: "1"
    memory: 1Gi

# ---------------------------------------------------------------------------
# 설정
# ---------------------------------------------------------------------------
config:
  LOG_LEVEL: "INFO"
  LOG_FORMAT: "json"        # CloudWatch 에서 파싱하기 좋게
  ENABLE_CRAWLER: "false"
  ALLOWED_ORIGINS: ""

  # 🔴 production 으로 두면 config.py 가 기동 가드를 켠다.
  #    SESSION_SECRET · 계정 비밀번호 · S3_BUCKET 이 비어 있으면
  #    프로세스가 임포트 단계에서 죽는다(CrashLoopBackOff).
  #    설정 누락을 조용히 넘기지 않으므로 운영에서는 이게 맞다.
  APP_ENV: "production"

  # 🔴 ALB 가 TLS 를 종료하고 뒤는 HTTP 다. 앱이 스스로 판단하면 항상 http 로
  #    보이므로 명시한다.
  COOKIE_SECURE: "true"

  # 🔴 S3 를 강제한다. 로컬 디스크 모드는 파드가 죽으면 업로드가 사라진다.
  ALLOW_LOCAL_STORAGE: "false"
  S3_BUCKET: "<S3_BUCKET_NAME>"
  AWS_REGION: "ap-northeast-2"
  # CloudFront 를 붙이면 그 도메인. 비우면 버킷 주소로 만든다.
  S3_PUBLIC_BASE: ""
  # 🔴 ALB 가 X-Forwarded-For 를 붙인다. 켜지 않으면 모든 사용자가
  #    ALB 의 IP 하나로 묶여, 첫 사용자가 상한을 채우면 전원이 막힌다.
  #
  #    ⚠️ ALB 기본 동작은 클라이언트가 보낸 XFF 뒤에 실제 IP 를 append 하는 것이다.
  #       앱이 "첫 값"을 쓰므로 클라이언트가 조작할 수 있다.
  #       ALB 속성 routing.http.xff_header_processing.mode = replace 로
  #       ALB 가 헤더를 덮어쓰게 해야 한다. (C 담당 / Terraform · Ingress 어노테이션)
  TRUST_PROXY_HEADERS: "true"

  # 🔴 최소 require. VPC 안이라도 DB 연결을 평문으로 두지 않는다.
  #    verify-full 로 올리려면 RDS 루트 CA 번들을 마운트해야 한다:
  #      curl -o rds-ca.pem https://truststore.pki.rds.amazonaws.com/ap-northeast-2/ap-northeast-2-bundle.pem
  #      kubectl create configmap rds-ca -n reverdi --from-file=rds-ca.pem
  #    그다음 DATABASE_SSL_ROOT_CERT 에 마운트 경로를 준다.
  DATABASE_SSL_MODE: "require"

# 🔴 External Secrets Operator 가 Secrets Manager 에서 만든다. 차트는 참조만.
secret:
  create: false
  name: reverdi-secret

# ---------------------------------------------------------------------------
# 배치
# ---------------------------------------------------------------------------
crawler:
  enabled: true
  schedule: "*/30 * * * *"

aggregate:
  enabled: false    # 클릭 집계 코드가 들어온 뒤 true

pgdump:
  enabled: false    # S3 업로드가 들어온 뒤 true
