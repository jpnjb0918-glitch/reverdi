image:
  repository: "${backend_repository}"
  tag: "${image_tag}"
  pullPolicy: IfNotPresent

crawlerImage:
  repository: "${crawler_repository}"

replicaCount: 3

nodeSelector:
  workload: web

resources:
  requests:
    cpu: 250m
    memory: 512Mi
  limits:
    cpu: "1"
    memory: 1Gi

strategy:
  maxSurge: 1
  maxUnavailable: 0

topologySpread:
  enabled: true
  maxSkew: 1
  topologyKey: topology.kubernetes.io/zone
  whenUnsatisfiable: DoNotSchedule

pdb:
  enabled: true
  minAvailable: 2

hpa:
  enabled: true
  minReplicas: 3
  maxReplicas: 6
  targetCPUUtilizationPercentage: 70

config:
  LOG_LEVEL: "INFO"
  LOG_FORMAT: "json"
  ENABLE_CRAWLER: "false"
  ALLOWED_ORIGINS: ""
  APP_ENV: "production"
  COOKIE_SECURE: "${cookie_secure}"
  ALLOW_LOCAL_STORAGE: "false"
  S3_BUCKET: "${bucket}"
  AWS_REGION: "${region}"
  S3_PUBLIC_BASE: ""
  TRUST_PROXY_HEADERS: "true"
  DATABASE_SSL_MODE: "require"

secret:
  create: false
  name: reverdi-secret

secretScope:
  perWorkload: true
  dbSecretName: reverdi-db-secret

crawler:
  enabled: true
  schedule: "*/30 * * * *"

aggregate:
  enabled: false

pgdump:
  enabled: false

migrate:
  enabled: true

serviceAccountName: reverdi-web
batchServiceAccountName: reverdi-batch

ingress:
  enabled: true
  className: alb
  host: "${domain}"
  certificateArn: "${certificate_arn}"
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/healthcheck-path: /health
    alb.ingress.kubernetes.io/listen-ports: '${https_enabled ? "[{\"HTTP\":80},{\"HTTPS\":443}]" : "[{\"HTTP\":80}]"}'
%{ if https_enabled }    alb.ingress.kubernetes.io/ssl-redirect: "443"%{ endif }
    alb.ingress.kubernetes.io/target-group-attributes: deregistration_delay.timeout_seconds=30
    alb.ingress.kubernetes.io/load-balancer-attributes: routing.http.xff_header_processing.mode=replace
